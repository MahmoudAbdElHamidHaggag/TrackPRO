 "html": "<html lang=\"ar\" dir=\"rtl\">\n    <body class=\"all\" style=\"direction:rtl;text-align:right\">\n        <div class=\"info_all\">\n            <div class=\"info_de\">\n                <div>\n                    \u0627\u0644\u0639\u0646\u0648\u0627\u0646:-\n                    {% if frappe.db.get_value('Address', address, 'address_line1') %}\n                      {{ frappe.db.get_value('Address', address, 'address_line1') }}\n                    {% endif %}\n               \n                    {% if frappe.db.get_value('Address', address, \"city\") %}\n                     - {{ frappe.db.get_value('Address', address, \"city\") }}\n                    {% endif %}\n                 \n                    {% if frappe.db.get_value('Address', address, 'state') %}\n                     - {{ frappe.db.get_value('Address', address, 'state') }}\n                    {% endif %}\n                        \n                    {% if frappe.db.get_value('Address', address, 'pincode') %}\n                     - {{ frappe.db.get_value('Address', address, 'pincode') }}\n                    {% endif %}\n                </div>\n                <div>\n                    \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a:-\n                    {% if frappe.db.get_value('Company', doc.company, 'tax_id') %}\n                      {{ frappe.db.get_value('Company', doc.company, 'tax_id') }}\n                    {% endif %}\n                </div>    \n            </div>\n            <div class=\"info_na\">\n                    {{ frappe.db.get_value (\"Company\", doc.company, \"company_name\")}}\n            </div>\n            <div class = \"image\">\n                <img class = \"logo\" src='{{frappe.db.get_value (\"Company\",doc.company,\"company_logo\")}}'>\n            </div>\n        </div>\n        <hr style=\"width:50%;\">\n        <div class = \"info_con\">\n            <fieldset class =\"boxed\">\n               <legend>\u0628\u064a\u0627\u0646\u0627\u062a \u0633\u0646\u062f \u0627\u0644\u062a\u0641\u0631\u064a\u063a </legend>\n               <div class=\"info_all\">\n                    <h4>\n                        \u0627\u0644\u062a\u0627\u0627\u0631\u064a\u062e:\n                        {{doc.date}}\n                    </h4>\n                    <h4>\n                        \u0627\u0644\u0648\u0642\u062a:\n                        {{ frappe.utils.get_time(doc.time)\n                         .strftime(\"%I:%M %p\")\n                         .lstrip('0')\n                         .replace('AM','\u0635')\n                         .replace('PM','\u0645') }}\n                    </h4>\n                </div>\n                <hr style=\"width:50%;\">\n               <fieldset class = \"boxed\">\n                   <legend>\u0631\u0642\u0645 \u0627\u0644\u0639\u0642\u062f</legend>\n                   {{doc.contract_of_carriage}}\n                   <hr style=\"width:50%;\">\n                   <fieldset class=\"boxed\">\n                       <legend>\u0631\u0642\u0645 \u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621</legend>\n                        {{doc.download_command}}\n                        <hr style=\"width:50%;\">\n                        <fieldset class=\"boxed\">\n                            <legend>\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0645\u0631 \u0627\u0644\u062a\u062d\u0645\u064a\u0644   </legend>\n                            <div class = \"info_all\">\n                                <h4>\n                                    \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644:\n                                    {{doc.loading_area}}\n                                </h4>\n                                <h4>\n                                    \u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u0645\u0644\u0629:\n                                    {{doc.loaded_quantity}}\n                                </h4>\n                            </div>\n                            <fieldset class=\"boxed\">\n                                <legend>\u0631\u0642\u0645 \u0623\u0645\u0631 \u0627\u0644\u062a\u062d\u0645\u064a\u0644  </legend>\n                                {{doc.delivery_order}}\n                            </fieldset>\n                            <fieldset class=\"boxed\">\n                                <legend>\u062a\u0641\u0627\u0635\u064a\u0644 \u0633\u0646\u062f \u0627\u0644\u062a\u0641\u0631\u064a\u063a</legend>\n                                    <h4>\n                                        \u0631\u0642\u0645 \u0633\u0646\u062f \u0627\u0644\u062a\u0641\u0631\u064a\u063a:\n                                        {{doc.name}}\n                                    </h4>\n                                <div class = \"info_all\">\n                                    <h4>\n                                        \u062d\u0627\u0644\u0629 \u0633\u0646\u062f \u0627\u0644\u062a\u0641\u0631\u064a\u063a:\n                                        {{doc.status}}\n                                    </h4>\n                                    <h4>\n                                        \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062a\u0641\u0631\u064a\u063a:\n                                        {{doc.unloading_area}}\n                                  </h4>\n                                </div>\n                                <div class = \"info_all\">\n                                    <h4>\n                                        \u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0641\u0631\u063a\u0629:\n                                        {{doc.unloaded_quantity}}\n                                    <h4>\n                                        {% if doc.difference_quantity > 0 %}\n                                            \u0641\u0631\u0642 \u0627\u0644\u0643\u0645\u064a\u0629:\n                                            {{doc.difference_quantity}}\n                                        {%endif%}\n                                    </h4>    \n                                     <h4>\n                                        {% if doc.difference_quantity > 0 %}\n                                            \u0646\u0633\u0628\u0629 \u0627\u0644\u0641\u0631\u0642\n                                            {{doc.difference_percentage}} %\n                                        {%endif%}\n                                    </h4> \n                                </div>\n                                <fieldset class=\"boxed\">\n                                    <legend>\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0634\u0627\u062d\u0646\u0647 \u0648\u0627\u0644\u0633\u0627\u0626\u0642</legend>\n                                    <h4>\n                                    \u0631\u0642\u0645 \u0644\u0648\u062d\u0629 \u0627\u0644\u0634\u0627\u062d\u0646\u0629:\n                                    {{doc.vehicle}}\n                                    </h4>\n                                    <h4>\n                                    \u0627\u0633\u0645 \u0627\u0644\u0633\u0627\u0626\u0642:\n                                    {{doc.driver}}\n                                    </h4>\n                                </fieldset>\n                            </fieldset>\n                         </fieldset>\n                    </fieldset>\n                </fieldset>\n            </fieldset>\n        </div>\n    </body>\n</html>",
