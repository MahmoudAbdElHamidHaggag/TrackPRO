 "css": ".print-format {\n    background-color: white;\n    border-radius: 0;\n    max-width: 210mm;\n    max-height: 297mm;\n    padding: 0;\n    margin: 5px;\n  }\n  \n  .print-format td, .print-format th {\n  padding: 5px !important;\n}\n\n@page {\n    size: A4 portrait !important;\n    margin: 0;\n}\n\n\nhtml, body {\n    margin: 0;\n    padding: 0;\n    width: 210mm;\n    max-height: 297mm;\n    background-color: #fff;\n}\n.info_all{\n    display: flex;\n    justify-content: space-between;\n    margin: 2px;\n    padding: 1px;\n}\n.info_na{\n    padding-top:20px;\n   font-size:3rem;\n   font-weight:700;\n   color:#0b3d91;\n    \n}\n.info_de{\n    display:grid;\n    padding-top:30px;\n     font-size:.8rem;\n   font-weight:600;\n}\n.image{\n    width:200px;\n    padding-left: 40px;\n    padding-right:40px;\n    padding-top:20px;\n}\n.info_con{\n    display:flex;\n    flex-wrap: wrap;\n     margin: 2px;\n    padding: 1px;\n}\n.boxed{\n    flex:30%;\n    border:1px solid #333;\n    border-radius:12px;\n    padding:.5rem 1rem .75rem;\n    margin:5px;\n    text-align:center;\n  }\n  .boxed > legend{\n   text-align:center;\n    font-weight:700;\n    font-size:1rem;\n  }\n",
